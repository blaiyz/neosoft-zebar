{
  "name": "neosoft-zebar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#static/*": "./static/*"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite build --mode dev --watch",
    "dev:once": "vite build --mode dev",
    "dev:mock": "vite dev --mode mock",
    "build": "node scripts/build.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/config_schema.ts --check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "schema": "node scripts/config_schema.ts && prettier --write static/schema.json",
    "verify": "pnpm lint && pnpm check && pnpm dev:once"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@lucide/svelte": "^1.0.0",
    "@tabler/icons-svelte": "^3.34.1",
    "@tauri-apps/api": "2.0.2",
    "glazewm": "^1.7.0",
    "json5": "^2.2.3",
    "svelte-range-slider-pips": "^4.1.1",
    "zebar": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.3.5"
  }
}
