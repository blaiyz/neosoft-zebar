{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "neosoft-zebar",
  "version": "1.2.8",
  "description": "A highly customizable (and smooooooth) Zebar build",
  "tags": [
    "glazewm",
    "media",
    "customizable",
    "rosé pine",
    "catppuccin",
    "weather",
    "system stats",
    "autotiler",
    "volume"
  ],
  "previewImages": [
    "preview/fullscreen.jpg",
    "preview/taskbar-integration.jpg"
  ],
  "repositoryUrl": "https://github.com/blaiyz/neosoft-zebar",
  "widgets": [
    {
      "name": "default",
      "htmlPath": "./index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["**"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "cmd",
            "argsRegex": "^/c start https://github\\.com/blaiyz/neosoft-zebar$"
          },
          {
            "program": "shutdown",
            "argsRegex": "^/(a|s)$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
